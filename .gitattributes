# Configuración global de finales de línea (Unix LF)
* text=auto eol=lf

# Forzar archivos de código y configuración como texto
*.js text
*.vue text
*.json text
*.html text
*.css text
*.md text

# Declarar explícitamente archivos binarios (assets del juego)
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# Ajustes de exportación
/MOCKUPS/ export-ignore
/docs/ export-ignore
.prettierrc export-ignore
.eslint.config.js export-ignore
.github/ export-ignore